{
  "name": "forest-management-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:i18n": "vitest run src/i18n/__tests__/keySync.test.ts",
    "i18n:scan": "node scripts/i18n-scan.mjs",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "test:e2e": "node scripts/run-e2e-with-cap.mjs",
    "test:e2e:bare": "playwright test",
    "perf:collect": "node scripts/perf-budget-gate.mjs --collect",
    "perf:check": "node scripts/perf-budget-gate.mjs",
    "perf:baseline": "node scripts/perf-budget-gate.mjs --collect --save-baseline",
    "perf:validate": "node scripts/perf-budget-gate.mjs --validate",
    "types:digitize": "openapi-typescript http://localhost:8001/openapi.json --output src/types/digitize-api.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "node scripts/check-tsc-baseline.mjs",
    "typecheck:update": "node scripts/check-tsc-baseline.mjs --update",
    "typecheck:strict": "tsc --noEmit",
    "lint": "node scripts/check-eslint-baseline.mjs",
    "lint:update": "node scripts/check-eslint-baseline.mjs --update",
    "lint:raw": "eslint src --ext .ts,.tsx",
    "lint:security": "node scripts/check-security-rules.mjs",
    "lint:security:update": "node scripts/check-security-rules.mjs --update",
    "lint:any": "node scripts/check-any-count.mjs",
    "lint:any:update": "node scripts/check-any-count.mjs --update"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@geoman-io/leaflet-geoman-free": "^2.19.2",
    "@sentry/react": "^8.55.2",
    "@tanstack/react-query": "^5.101.2",
    "@turf/turf": "^7.3.4",
    "@types/dompurify": "^3.0.5",
    "antd": "^6.3.3",
    "axios": "^1.6.2",
    "caniuse-lite": "^1.0.30001806",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.12",
    "html2canvas": "^1.4.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.574.0",
    "papaparse": "^5.5.3",
    "proj4": "^2.20.3",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.10",
    "react-leaflet": "^5.0.0",
    "react-nepali-datepicker-bs": "^2.2.4",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.18.1",
    "web-vitals": "^6.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/html2canvas": "^0.5.35",
    "@types/leaflet": "^1.9.8",
    "@types/papaparse": "^5.5.2",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^63.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "i18next-parser": "^9.0.2",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^2.1.9"
  }
}
