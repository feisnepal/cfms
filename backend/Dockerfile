# ---- Backend ----
# H5.1 / S2-27: multi-stage, non-root, healthchecked.
#
# The single-stage image shipped `gcc` and `libgdal-dev` into production. A
# compiler in a runtime image is a standing offer to anyone who reaches code
# execution: it turns "I can run a command" into "I can build whatever I like,
# here, with your credentials in the environment". Nothing needs to compile
# after the wheels are built, so nothing that compiles belongs in the runtime.

# ---------- build stage ----------
FROM python:3.11-slim AS build

# Build-only toolchain. None of this survives into the runtime image.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev libgdal-dev \
    && rm -rf /var/lib/apt/lists/*

# A virtualenv rather than the system site-packages, so the runtime stage can
# take the whole tree with one COPY and nothing else comes with it.
ENV VIRTUAL_ENV=/opt/venv
RUN python -m venv "$VIRTUAL_ENV"
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

WORKDIR /app

# H1.2 / S1-25: install from the hashed lock, not the manifest.
#
# requirements.txt lists direct dependencies only, so pip resolved the
# transitive tree afresh on every build — two builds of the same commit could
# differ. requirements.lock pins all 100 packages with hashes, generated by
# pip-compile on Python 3.11 (this image), so --require-hashes both reproduces
# the tree exactly and rejects any artifact whose content has changed.
COPY requirements.lock .
RUN pip install --no-cache-dir --require-hashes -r requirements.lock

# ---------- runtime stage ----------
FROM python:3.11-slim AS runtime

# Runtime libraries only — no compiler, no -dev headers. `gdal-bin` stays
# because the geospatial stack shells out to it, and `postgresql-client` stays
# because the deploy pipeline and the restore runbook both use pg_dump and
# pg_restore from inside this image.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 gdal-bin postgresql-client curl \
    && rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
COPY --from=build /opt/venv /opt/venv

# H2.12 / security-scan: purge the packaging toolchain from the runtime image.
#
# Trivy fails on HIGHs in `wheel` (CVE-2026-24049) and `jaraco.context`
# (CVE-2026-23949). Neither is in requirements.lock, and the first attempt at
# this -- uninstalling the top-level `wheel` -- did not fix it, because that is
# not where Trivy was finding them:
#
#   opt/venv/lib/python3.11/site-packages/setuptools/_vendor/wheel-0.45.1.dist-info
#   usr/local/lib/python3.11/site-packages/setuptools/_vendor/jaraco.context-5.3.0...
#
# setuptools VENDORS its own copies, and Trivy reads their dist-info METADATA.
# Removing setuptools removes both, and every future finding in anything else
# it vendors -- there are eighteen such packages in the image.
#
# Nothing here needs it. setuptools and wheel exist to BUILD distributions; the
# wheels were built in the build stage and this image only runs the result. A
# production image that cannot install packages is a feature, the same argument
# that removed gcc above. `pip` is deliberately kept: it has no finding, and
# removing it would be extra risk for no benefit today.
#
# The risk is `pkg_resources`, which some libraries import at runtime and which
# ships with setuptools. Nothing in this dependency set does -- checked -- but
# the real proof is compose-smoke, which now actually starts the app and would
# fail on an ImportError. That check exists only because the same CI run fixed
# it; before today this change could not have been verified at all.
#
# `pip uninstall` of an absent package warns and exits 0, so this survives a
# base image that stops shipping them. The assertion is what makes the step
# trustworthy: there is no Docker on the development machine, so a purge that
# silently did nothing would look exactly like one that worked, and the job
# would go green for the wrong reason.
RUN "$VIRTUAL_ENV/bin/python" -m pip uninstall -y setuptools wheel \
    && /usr/local/bin/python -m pip uninstall -y setuptools wheel \
    && for py in "$VIRTUAL_ENV/bin/python" /usr/local/bin/python; do \
         for mod in setuptools wheel pkg_resources; do \
           if "$py" -c "import $mod" 2>/dev/null; then \
             echo "FAIL: $mod still importable from $py" >&2; \
             exit 1; \
           fi; \
         done; \
       done \
    && echo "packaging toolchain purged from both interpreters"

# Unbuffered so container logs appear as they happen rather than when a buffer
# fills — the difference between watching a deploy and guessing at one.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# A non-root user, created before the code is copied so the COPY can set
# ownership in one layer. `uploads` and `exports` are written at runtime, so
# they must belong to the user that will be writing them.
RUN useradd --create-home --shell /usr/sbin/nologin --uid 10001 appuser \
    && mkdir -p /app/uploads /app/exports \
    && chown -R appuser:appuser /app

COPY --chown=appuser:appuser . .

USER appuser

EXPOSE 8000

# The orchestrator should learn the app is unhealthy from the app, not from a
# port being open. `/health` checks the database connection too, so a container
# that cannot reach Postgres reports itself unhealthy instead of accepting
# traffic it cannot serve.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

# H2.18 / S2-08: behind nginx every request arrives from the proxy's address.
# Without --proxy-headers the app sees one client for the whole deployment, so
# rate limits, audit rows and abuse signals all name the proxy. The trusted set
# is an env var because it is a property of the deployment, not the image —
# and it must stay a *set*, never "*": trusting any peer's X-Forwarded-For lets
# a caller claim whatever address it likes.
ENV FORWARDED_ALLOW_IPS=127.0.0.1

# NOTE (H5.1, deliberately not done): this should be gunicorn with uvicorn
# workers, not a bare uvicorn. `gunicorn` is not in requirements.lock, and the
# lock is hash-pinned and must be regenerated on Python 3.11 — which cannot be
# done from the Windows/3.14 development machine. Do it in the same pass as the
# python-multipart bump (see security/README.md); worker sizing is task 3.3.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips \"$FORWARDED_ALLOW_IPS\""]
