sentry-sdk==2.14.0
prometheus-fastapi-instrumentator==8.0.2

# ── Background task queue (report T15 — report/export jobs) ──
arq==0.28.0

# ── Fuzzy matching (species names, spreadsheet column mapping) ──
# UNDECLARED until 2026-08-25. `from fuzzywuzzy import fuzz` sits at module
# level in app/services/validators/species_matcher.py and app/utils/column_mapper.py,
# both reached from api/inventory.py, api/species.py and api/workspace.py — so a
# clean install of this file produced an application that could not import, and
# every Docker build shipped one. It survived because it was installed on the
# developer machine and CI had never once started the app.
# python-Levenshtein is fuzzywuzzy's C backend: without it fuzzywuzzy warns on
# import and falls back to a pure-Python matcher roughly an order of magnitude
# slower, which matters when mapping every column of a large inventory upload.
fuzzywuzzy==0.18.0
python-Levenshtein==0.27.3

# ── Excel and SVG rendering ──
# Both UNDECLARED until 2026-08-25, and both absent from the lock entirely.
# Unlike fuzzywuzzy above these are imported inside functions, so they do not
# break startup — they break the feature, at the moment somebody uses it:
#   openpyxl : the household Excel template, inventory upload parsing,
#              excel_validator, and every .xlsx export (4 modules)
#   CairoSVG : SVG->PNG for the charts embedded in the operational plan
# A clean install would have produced an app that starts, passes a health
# check, and then fails the first time a district officer exports a workbook.
openpyxl==3.1.2
CairoSVG==2.9.0

# mplcairo : renders matplotlib figures through cairo (HarfBuzz text shaping) so
# Devanagari conjuncts (क्ष, त्र, ज्ञ) in map & chart labels come out correct.
# Imported lazily in app.core.text_shaping; absent → Agg fallback (correct font,
# imperfect shaping), never a startup failure. Needs libcairo (+ its HarfBuzz);
# manylinux wheels bundle it. THEMATIC_MAP_VARIABLES_PLAN §3.8 / P2.
mplcairo==0.6.1

