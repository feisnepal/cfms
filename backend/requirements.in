# Direct dependencies — the source of truth (H1.2 / S1-25).
#
# `requirements.txt` is GENERATED from this file and must not be hand-edited:
#
#     pip-compile --generate-hashes requirements.in -o requirements.txt
#
# Run it on the supported interpreter (Python 3.11 — see /.python-version), not
# on whatever happens to be on PATH. A lock resolved on a different Python can
# select different wheels, which is how this project ended up running geopandas
# 1.1.2 against a pinned 0.14.1. CI regenerates and verifies the lock on 3.11;
# see the `deps-lock` job in .github/workflows/ci.yml.
#
# Transitive dependencies belong in the lock, not here. Add a package here only
# when the application imports it directly.

# ── Web framework ──
fastapi==0.139.2
uvicorn[standard]==0.48.0
# 0.0.7 -> 0.0.32 (2026-08-25). Two independent reasons, either sufficient:
#   - CVE-2026-53539: a crafted form-urlencoded body. Trivy flags it against the
#     backend image; the tracker has carried it as "16 advisories,
#     network-reachable" since Phase 1.
#   - fastapi==0.139.2 requires python-multipart>=0.0.18, so the pin was BELOW
#     what the pinned FastAPI itself asks for.
# Safe here: the application never imports `multipart` directly, only FastAPI's
# Form and UploadFile, so the library's internal module rename does not reach us.
python-multipart==0.0.32
slowapi==0.1.10

# ── Database ──
sqlalchemy==2.0.45
psycopg2-binary==2.9.11
alembic==1.18.4

# ── Geospatial ──
# Pinned tightly and deliberately: these carry compiled GEOS/GDAL/PROJ bindings,
# and a minor bump can silently change CRS handling or predicate results. Treat
# any change here as a code change — see report S1-25.
geoalchemy2==0.20.0
shapely==2.1.2
# fiona REMOVED 2026-08-25. It carried CVE-2023-45853 (CRITICAL, bundled
# MiniZip) and CVE-2020-14152 (HIGH), which failed the Trivy image scan.
# Its only use in the codebase was one GPKG export in api/compartments.py,
# now written with pyogrio below -- geopandas' default engine, already a
# dependency, the same GDAL underneath. Removing it retires the finding
# permanently instead of tracking fiona's advisories forever, and drops a
# compiled dependency the project did not need. Do not re-add it:
# tests/test_compartment_gpkg_export.py fails on any fiona import in app/.
pyproj==3.7.2
geopandas==1.1.2
pyogrio==0.12.1
rasterio==1.4.4
pyshp==3.1.4
geojson==3.3.0

