# ── Testing ──
pytest==9.0.3
pytest-asyncio==1.3.0
# H1.7 — test-suite integrity plugins.
# randomly: order-dependence fails immediately instead of being baked in.
# xdist:    a >10-minute serial suite does not get run, and a suite that is
#           not run is not a gate.
# timeout:  a hung test used to hang the job forever; there was no timeout
#           anywhere in CI.
pytest-randomly==3.15.0
pytest-xdist==3.6.1
pytest-timeout==2.3.1
# H1.9 — coverage measurement. Absent entirely before this: 1,297 backend
# tests could not be related to the ~114k lines they nominally cover.
pytest-cov==5.0.0
# UNDECLARED until 2026-08-25. tests/conftest.py registers a Hypothesis profile
# (H1.17, to suppress a `too_slow` health check under xdist) and three property
# suites import it, so a clean install collected them as ERRORs. The earlier
# undeclared-import audit missed it by scanning app/ only, not tests/ — the
# import graph that has to resolve is both.
hypothesis==6.112.1
# httpx was pinned to 0.27.2 because starlette 0.27.0 (then required by fastapi
# 0.104.1) passed `app=app` positionally to httpx.Client, which 0.28 forbade.
# That rationale is dead: this project now runs fastapi 0.139.2 / starlette 1.1.0,
# and the full 1,297-test suite — TestClient paths included — passes on httpx
# 0.28.1. Floor set at 0.28 rather than restoring the stale pin.
httpx>=0.28,<0.29

# ── Caching ──
# Previously unpinned (>=0.2.2). Pinned to the version this project is verified
# against; an unpinned dependency is an unreproducible build.
# The [redis] extra is deliberately NOT requested: it constrains redis<5.0.0,
# which conflicts with arq's redis<6,>=4.2.0 and with the redis 5.3.1 this
# project actually runs. The extra only pulls redis in, and redis is pinned
# directly below — `fastapi_cache.backends.redis` imports fine without it.
# Verified: pip check is clean, and the extra is not installed today.
fastapi-cache2==0.2.2
redis==5.3.1
cachetools==7.1.4

