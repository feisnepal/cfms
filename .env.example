# Database Configuration
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/cf_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# JWT Authentication
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Upload Settings
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.shp,.kml,.geojson,.json,.gpkg,.zip
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Application Settings
APP_NAME=Community Forest Management System
APP_VERSION=1.0.0
DEBUG=False  # Set to True for development — must be False in production

# Redis (optional — report/export background jobs + cache; falls back to
# in-memory when unreachable)
REDIS_URL=redis://localhost:6379/0

# AI providers (report generation) — leave blank to use rule-based fallback
GEMINI_API_KEY=
GROQ_API_KEY=

# Observability (all optional — unset = no-op)
SENTRY_DSN=                       # backend Sentry (errors). Unset disables.
LOG_FORMAT=text                  # "text" or "json" (structured logs)
ENABLE_METRICS=true              # Prometheus /metrics endpoint
# Frontend Sentry (set in frontend/.env as VITE_SENTRY_DSN); unset disables.


# ── Docker Compose (H1.13 / S2-69) ──
# docker-compose.yml no longer inlines these; it fails to start without them.
# The password previously sat in the tracked docker-compose.yml and
# backend/alembic.ini in plain text.
POSTGRES_PASSWORD=change-me
